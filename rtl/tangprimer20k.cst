// Sipeed Tang Primer 20K + Dock ext-board - physical constraints for
// rtl/top_tangprimer20k.sv
//
// The third board file, after rtl/top.pcf (BlackIce MX) and
// rtl/tangnano20k.cst. Pin names here are FPGA BALL DESIGNATORS on the
// GW2A-LV18PG256C8/I7 (PG256, a 256-ball BGA), not header positions - the
// Primer 20K is a bare core board in a DDR3 SODIMM outline, and every
// peripheral lives on the ext-board it plugs into. So a ball tells you nothing
// about where a wire goes without the Dock schematic; the CARD1 SODIMM position
// is in the comment on each line for exactly that reason.
//
// Provenance, because none of this has been on hardware: ball/position pairs
// come from litex-boards' sipeed_tang_primer_20k.py, which carries the full
// 204-position CARD1 map and the Dock's LED/key assignment, cross-checked
// against Sipeed's own TangPrimer-20K-example .cst files. Where the two
// disagree nothing has been invented - see docs/boards.md.
//
// nextpnr-himbaechel requires EVERY top-level port to appear here - an
// unassigned port is an error, not a warning, so this file and the port list of
// top_tangprimer20k.sv have to be kept in step.
//
// ---------------------------------------------------------------------------
// Clock
// ---------------------------------------------------------------------------
// The 27 MHz crystal on the CORE board, so this one ball is the same whichever
// ext-board is fitted. 27 MHz is also the Tang Nano 20K's crystal, which is why
// rtl/pll_gowin.v is reused here unchanged and every derived frequency in
// rtl/clocks.sv is identical on the two Gowin boards.
IO_LOC  "clk" H11;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// ---------------------------------------------------------------------------
// User keys (active low)
// ---------------------------------------------------------------------------
// The Dock has five user keys. Only ONE of them, btn_n0, is in a 3.3 V bank;
// the other four sit in the bank the Dock's DDR3 shares, so they are 1.5 V I/O
// and must be declared LVCMOS15 or the bank is configured at the wrong voltage.
// That is not a workaround - Sipeed's own LiteX constraints declare them the
// same way. This design instantiates no DDR3, but the bank VCCIO is a board
// fact, not a design choice.
IO_LOC  "key1" T10;  // CARD1:15,  btn_n0 - reads as button O ($4007 bit 4)
IO_PORT "key1" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "key2" T3;   // CARD1:165, btn_n1 - reads as button X ($4007 bit 5)
IO_PORT "key2" IO_TYPE=LVCMOS15 PULL_MODE=UP;

// ---------------------------------------------------------------------------
// LEDs (assumed active low)
// ---------------------------------------------------------------------------
// Dock led0 and led1. Both mean "healthy": a working board shows two lit LEDs
// shortly after power-on, and one lit with one dark localises a fault to one
// side of the PLL.
//
// POLARITY IS UNVERIFIED. Sipeed's board self-test drives these LEDs to all-ones
// at reset, which only makes sense if they are active low, and every other Tang
// board here is active low - but nobody has looked at this one. If both LEDs are
// dark on a board that is otherwise working, invert the two `assign`s in
// rtl/top_tangprimer20k.sv; that is the whole fix.
IO_LOC  "led_reset" L16;  // CARD1:44, led0 - lit once reset is released
IO_PORT "led_reset" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "led_lock" L14;   // CARD1:46, led1 - lit once the PLL has locked
IO_PORT "led_lock" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// ---------------------------------------------------------------------------
// SPI LCD - MuseLab PMOD-TFTLCD v1.1 on PMOD2 (2.8", 320x240, SPI)
// ---------------------------------------------------------------------------
// The module carries two connectors: J2 is the display, J3 is an XPT2046 touch
// controller. J2 sits in PMOD2 and J3 in PMOD3.
//
// THE MODULES ARE MOUNTED FACING OUTWARD, WHICH SHIFTS EVERY SIGNAL BY SIX.
// That is not a mistake, it is the only orientation in which the power pins
// line up: MuseLab puts GND on connector pins 5 and 8 and 3V3 on 6 and 7,
// while the Dock follows Digilent (GND on 5 and 11, VCC on 6 and 12). Seated
// this way, 3V3 meets 3V3 and GND meets GND, and the four signals move from
// the module's pins 1-4 to the Dock's P7-P10:
//
//     module J2 pin 1  CS   -> PMOD2 P7  -> D14
//     module J2 pin 2  MOSI -> PMOD2 P8  -> B14
//     module J2 pin 4  CLK  -> PMOD2 P10 -> B12
//     module J2 pin 10 RS   -> PMOD2 P3  -> A14
//
// RS IS ON PIN 10, IN THE OTHER ROW - not pin 3, which is unconnected. The
// module's connector is numbered serpentine (1..6 down one column, 12..7 down
// the other), so its four signals are NOT all in one row: CS/MOSI/CLK sit at
// positions 1,2,4 of the first column and RS at position 3 of the second.
// After the row swap that puts RS back on the Dock's FIRST row, at P3.
//
// This cost a hardware debugging round. Reading the schematic as flattened
// text put RS on pin 3; only extracting the label COORDINATES and matching
// them to the connector's pin-number rows showed it on pin 10. The symptom was
// a completely white panel with everything else working - RS floating means
// the controller cannot tell a command from a pixel, so the init never lands.
// The same extraction confirms J3's MISO and CLK on pins 3 and 4, which map to
// N9 and L9 and are exactly what the board measures.
//
// PMOD2's P1, P2, P4 (E15, A15, C12) and every PMOD3 pin are deliberately NOT
// constrained. Nothing needs them, and leaving them as inputs means an FPGA
// output can never meet whatever the module presents there - in particular the
// XPT2046's MISO, which is an output. With the serpentine numbering understood,
// the module's unconnected pins 9/11/12 land on those three balls and its power
// pins land on the Dock's power pins, so nothing is being fought over.
//
// Ball assignments are from ciniml's Tang Primer 20K Pmod Extender, whose whole
// purpose is documenting this mapping; none of them collide with anything the
// Dock assigns. Note PMOD2 and PMOD3 share pins with the RGB LCD FPC connector,
// so do not populate that at the same time.
IO_LOC  "scl" B12;      // PMOD2 P10 <- module J2 pin 4, SPI clock
IO_PORT "scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "sda" B14;      // PMOD2 P8  <- module J2 pin 2, SPI data (MOSI)
IO_PORT "sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "cs" D14;       // PMOD2 P7  <- module J2 pin 1, chip select
IO_PORT "cs" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "rs" A14;       // PMOD2 P3  <- module J2 pin 10, data/command
IO_PORT "rs" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// Parked, not wired. The module ties the panel's RESET pin to 3V3, so the FPGA
// cannot reset it and this signal has no destination - but nextpnr and Gowin
// both require every port to be constrained. PMOD1 is empty, so this drives
// nothing. If a panel that DOES expose RESET is ever fitted, this is the pin to
// move onto it.
IO_LOC  "lcd_rst" P11;  // PMOD1 P1 - empty connector
IO_PORT "lcd_rst" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// ---------------------------------------------------------------------------
// Audio
// ---------------------------------------------------------------------------
// The Dock's 3.5mm headphone jack: a PT8211 DAC into an LPA4809 amplifier.
// Fixed by the board; these are not a choice. Note the DAC is NOT an I2S
// receiver - see the header of rtl/pt8211_out.sv for what that costs.
IO_LOC  "hp_bck" N15;   // CARD1:36
IO_PORT "hp_bck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "hp_ws" P16;    // CARD1:34
IO_PORT "hp_ws" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "hp_din" P15;   // CARD1:30
IO_PORT "hp_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "pa_en" R16;    // CARD1:28 - amplifier enable, high = enabled
IO_PORT "pa_en" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// ---------------------------------------------------------------------------
// MuseLab PMOD-AUDIO v1.2 on PMOD0 - the speaker that actually makes noise
// ---------------------------------------------------------------------------
// This module is ANALOGUE IN, not I2S: its inputs go through 22K + 1uF into a
// PAM8403 class-D amplifier driving an onboard speaker and a 3.5mm jack. So it
// is fed by rtl/dsigma.sv - the 1-bit delta-sigma stage the BlackIce uses -
// and not by the PT8211 path above. The 22K/1uF is the reconstruction network
// that docs/boards.md says this output stage needs off-board.
//
// Same outward-facing orientation as the LCD, so the same +6 shift:
//
//     module J1 pin 1 IL -> PMOD0 P7 -> T6
//     module J1 pin 2 IR -> PMOD0 P8 -> T7
//
// Both channels are driven from the same mono PSG output, so the speaker and
// both sides of the headphone jack get the same signal.
//
// PMOD0's P1-P4 (P6, R8, P8, T9) are deliberately left unconstrained, for the
// same reason as PMOD2's.
IO_LOC  "audio_pwm" T6;    // PMOD0 P7 <- module J1 pin 1, IL
IO_PORT "audio_pwm" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "audio_pwm_r" T7;  // PMOD0 P8 <- module J1 pin 2, IR
IO_PORT "audio_pwm_r" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
